generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum Category {
  FOOD
  DRINK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  avatarUrl    String?
  googleId     String?   @unique
  passwordHash String?
  bio          String?   @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recipes  Recipe[]
  saves    RecipeSave[]
  likes    RecipeLike[]
  comments RecipeComment[]

  following Follow[] @relation("Follows")
  followers Follow[] @relation("FollowedBy")
  notifications Notification[]
  conversations ConversationParticipant[]
  sentMessages  Message[]

  @@index([email])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String   @default("FOLLOW")
  text      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Recipe {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  description String     @default("")
  coverUrl    String?
  category    Category   @default(FOOD)
  ingredients Json
  steps       Json
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  difficulty  Difficulty?
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  saves    RecipeSave[]
  likes    RecipeLike[]
  comments RecipeComment[]

  @@index([visibility])
  @@index([authorId])
}

model RecipeSave {
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
}

model RecipeLike {
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
}

model RecipeComment {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  parent RecipeComment? @relation("RecipeCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies RecipeComment[] @relation("RecipeCommentReplies")

  @@index([recipeId])
  @@index([parentId])
}
